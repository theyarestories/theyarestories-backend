{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./api",
    "sourceMap": true,
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./api/*"]
    }
  },
  "ts-node": {
    "files": true
  },
  "include": ["api/**/*.ts"]
}
